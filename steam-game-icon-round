#!/usr/bin/env bash

set -euo pipefail

usage() {
    cat <<'EOF'
Usage:
  steam-game-icon-round [--radius N] IMAGE [IMAGE...]

Adds transparent rounded corners to one or more square PNG icons.
The default radius is 56 pixels for 256x256 artwork and can also be set with
STEAM_ICON_CORNER_RADIUS.
EOF
}

radius="${STEAM_ICON_CORNER_RADIUS:-56}"

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    usage
    exit 0
fi

if [[ "${1:-}" == "--radius" ]]; then
    [[ $# -ge 3 ]] || {
        usage >&2
        exit 2
    }
    radius="$2"
    shift 2
fi

[[ "$radius" =~ ^[0-9]+$ ]] || {
    printf 'error: radius must be a non-negative integer\n' >&2
    exit 2
}

(( $# > 0 )) || {
    usage >&2
    exit 2
}

command -v magick >/dev/null 2>&1 || {
    printf 'error: ImageMagick (magick) is required\n' >&2
    exit 1
}

for source in "$@"; do
    [[ -f "$source" ]] || {
        printf 'error: not a regular file: %s\n' "$source" >&2
        exit 1
    }

    width="$(magick identify -format '%w' "$source")"
    height="$(magick identify -format '%h' "$source")"
    [[ "$width" == "$height" ]] || {
        printf 'error: icon must be square: %s (%sx%s)\n' "$source" "$width" "$height" >&2
        exit 1
    }

    max_radius=$(( width / 2 ))
    effective_radius="$radius"
    (( effective_radius <= max_radius )) || effective_radius="$max_radius"

    output_dir="$(dirname -- "$source")"
    temporary="$(mktemp --tmpdir="$output_dir" '.steam-icon-round.XXXXXX.png')"
    trap 'rm -f -- "$temporary"' EXIT

    magick "$source" \
        -alpha set \
        \( -size "${width}x${height}" xc:none \
           -fill white \
           -draw "roundrectangle 0,0,$((width - 1)),$((height - 1)),${effective_radius},${effective_radius}" \) \
        -compose DstIn \
        -composite \
        -strip \
        PNG32:"$temporary"

    chmod --reference="$source" "$temporary"
    mv -f -- "$temporary" "$source"
    trap - EXIT

    printf 'rounded: %s (radius=%s)\n' "$source" "$effective_radius"
done
